<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared by the chapter pages. Diagrams are drawn on dark "plates" (space is dark), so controls over a plate use
        the dark `space` classes; controls on the paper page use the light `chip` classes.
    -->
    <Styles.Resources>
        <SolidColorBrush x:Key="SpaceText" Color="#F2F4F8" />
        <SolidColorBrush x:Key="SpaceTextSecondary" Color="#C9D1DC" />
        <SolidColorBrush x:Key="SpaceTextDim" Color="#9AA5B5" />
        <SolidColorBrush x:Key="SpaceGlass" Color="#D10B1019" />
        <SolidColorBrush x:Key="SpaceGlassBorder" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="SpaceDivider" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="PlateBrush" Color="#06080F" />

        <!-- Simple 24x24 icons, drawn for this project. -->
        <StreamGeometry x:Key="Icon.Play">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pause">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Previous">M6,5 H8 V19 H6 Z M19,5 V19 L9,12 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Next">M16,5 H18 V19 H16 Z M5,5 V19 L15,12 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Restart">M12,5 A7,7 0 1 0 19,12 H17 A5,5 0 1 1 12,7 V10 L16,6 L12,2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Close">M5.6,4.2 L12,10.6 L18.4,4.2 L19.8,5.6 L13.4,12 L19.8,18.4 L18.4,19.8 L12,13.4 L5.6,19.8 L4.2,18.4 L10.6,12 L4.2,5.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Check">M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Voice">M3,9 H7 L12,4 V20 L7,15 H3 Z M15,7 A6,6 0 0 1 15,17 L15,15 A4,4 0 0 0 15,9 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Mute">M3,9 H7 L12,4 V20 L7,15 H3 Z M15.3,8.5 L17.5,10.7 L19.7,8.5 L21.1,9.9 L18.9,12.1 L21.1,14.3 L19.7,15.7 L17.5,13.5 L15.3,15.7 L13.9,14.3 L16.1,12.1 L13.9,9.9 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pin">M12,2 A7,7 0 0 1 19,9 C19,14 12,22 12,22 C12,22 5,14 5,9 A7,7 0 0 1 12,2 Z M12,6 A3,3 0 1 0 12,12 A3,3 0 1 0 12,6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ChevronDown">M7,9 L12,14 L17,9 L18.4,10.4 L12,16.8 L5.6,10.4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Contents">M4,5 H6.4 V7.4 H4 Z M8.5,5.5 H20 V6.9 H8.5 Z M4,10.8 H6.4 V13.2 H4 Z M8.5,11.3 H20 V12.7 H8.5 Z M4,16.6 H6.4 V19 H4 Z M8.5,17.1 H20 V18.5 H8.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Note">M5,3 H15 L19,7 V21 H5 Z M14,4.6 V8 H17.4 Z M8,11 H16 V12.4 H8 Z M8,14.5 H16 V15.9 H8 Z M8,18 H13 V19.4 H8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.WindowMinimize">M6,11.4 H18 V12.6 H6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.WindowMaximize">M6,6 H18 V18 H6 Z M7.2,7.2 V16.8 H16.8 V7.2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.WindowRestore">M8.5,6 H18 V15.5 H15.5 V18 H6 V8.5 H8.5 Z M9.7,7.2 V8.5 H15.5 V14.3 H16.8 V7.2 Z M7.2,9.7 V16.8 H14.3 V9.7 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.WindowClose">M6.85,6 L12,11.15 L17.15,6 L18,6.85 L12.85,12 L18,17.15 L17.15,18 L12,12.85 L6.85,18 L6,17.15 L11.15,12 L6,6.85 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Lock">M7,10 V7.5 A5,5 0 0 1 17,7.5 V10 H19 V21 H5 V10 Z M9,10 H15 V7.5 A3,3 0 0 0 9,7.5 Z M11,14 V18 H13 V14 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Words">M4,4 H11 V11 H4 Z M13,4 H20 V11 H13 Z M4,13 H11 V20 H4 Z M13,13 H20 V20 H13 Z M5.4,5.4 V9.6 H9.6 V5.4 Z M14.4,5.4 V9.6 H18.6 V5.4 Z M5.4,14.4 V18.6 H9.6 V14.4 Z M14.4,14.4 V18.6 H18.6 V14.4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Bookmark">M6,2.5 H18 V21.5 L12,16.8 L6,21.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Settings">F1 M12,4.5 A7.5,7.5 0 1 1 12,19.5 A7.5,7.5 0 1 1 12,4.5 Z M18,10.3 L21.5,10.3 L21.5,13.7 L18,13.7 Z M17.44,15.04 L19.92,17.52 L17.52,19.92 L15.04,17.44 Z M13.7,18 L13.7,21.5 L10.3,21.5 L10.3,18 Z M8.96,17.44 L6.48,19.92 L4.08,17.52 L6.56,15.04 Z M6,13.7 L2.5,13.7 L2.5,10.3 L6,10.3 Z M6.56,8.96 L4.08,6.48 L6.48,4.08 L8.96,6.56 Z M10.3,6 L10.3,2.5 L13.7,2.5 L13.7,6 Z M15.04,6.56 L17.52,4.08 L19.92,6.48 L17.44,8.96 Z M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z</StreamGeometry>

        <!-- A flat, round pill: the template of every `space` and `chip` button. -->
        <ControlTemplate x:Key="PillTemplate" TargetType="ContentControl">
            <Border Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="17"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>
    </Styles.Resources>

    <!-- Dark controls over a diagram plate -->
    <Style Selector=":is(Button).space, ToggleButton.space, RadioButton.space">
        <Setter Property="Template" Value="{StaticResource PillTemplate}" />
        <Setter Property="Foreground" Value="{StaticResource SpaceText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).space:pointerover /template/ Border#Chrome, ToggleButton.space:pointerover /template/ Border#Chrome, RadioButton.space:pointerover /template/ Border#Chrome">
        <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="ToggleButton.space:checked /template/ Border#Chrome, RadioButton.space:checked /template/ Border#Chrome">
        <Setter Property="Background" Value="#3D5AA9FF" />
        <Setter Property="BorderBrush" Value="#995AA9FF" />
    </Style>
    <Style Selector=":is(Button).space:focus-visible /template/ Border#Chrome, ToggleButton.space:focus-visible /template/ Border#Chrome, RadioButton.space:focus-visible /template/ Border#Chrome">
        <Setter Property="BorderBrush" Value="#E6FFFFFF" />
    </Style>
    <Style Selector=":is(Button).space:disabled, ToggleButton.space:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector=".space PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- A flyout on paper (the location picker, the settings) -->
    <Style Selector="FlyoutPresenter.paper">
        <Setter Property="Background" Value="{DynamicResource FlyoutPaperBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,4,16,16" />
        <Setter Property="Width" Value="380" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Light pills on the paper page -->
    <Style Selector="Button.chip, RadioButton.chip, ToggleButton.chip">
        <Setter Property="Template" Value="{StaticResource PillTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ Border#Chrome, RadioButton.chip:pointerover /template/ Border#Chrome, ToggleButton.chip:pointerover /template/ Border#Chrome">
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ Border#Chrome, ToggleButton.chip:checked /template/ Border#Chrome">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.chip:focus-visible /template/ Border#Chrome, RadioButton.chip:focus-visible /template/ Border#Chrome, ToggleButton.chip:focus-visible /template/ Border#Chrome">
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector=".chip PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- A list shown as light pills that wrap (pick one), on the paper page -->
    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Template" Value="{StaticResource PillTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,4,12,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ Border#Chrome">
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ Border#Chrome">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:focus-visible /template/ Border#Chrome">
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>

    <!-- Captions and text on a chapter's left page -->
    <Style Selector=":is(TextBlock).caption">
        <Setter Property="Margin" Value="0,16,0,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).note">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource FaintInkBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).text">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource BodyInkBrush}" />
    </Style>

    <!-- A framed figure on the paper page: a dark plate with rounded corners. -->
    <Style Selector="Border.plate">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
</Styles>
