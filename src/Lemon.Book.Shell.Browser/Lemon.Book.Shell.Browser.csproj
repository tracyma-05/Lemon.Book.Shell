<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    What the books' web heads share: the narration player, settings in localStorage, signing in by redirect, and the
    page's scripts. The Razor SDK makes wwwroot static web assets, so a book serves them at
    _content/Lemon.Book.Shell.Browser/ (download-progress.js, wake-lock.js, narration.js).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RootNamespace>Lemon.Book.Shell.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Lemon.Book.Shell.Browser</PackageId>
    <Description>The Lemon books' web pieces: narration through Web Audio, settings in localStorage, sign-in by redirect, and the splash's download progress.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lemon.Book.Shell\Lemon.Book.Shell.csproj" />
    <!-- Sign-in by redirect (RedirectSignInFlow), from the hub client. -->
    <ProjectReference Include="..\Lemon.Hub.Client.Browser\Lemon.Hub.Client.Browser.csproj" />
    <!-- Keeps a book's `new RedirectSignInFlow()` under `using Lemon.Book.Shell.Browser;` compiling (see the file). -->
    <None Include="buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
