<Project>

  <!-- Auto-imported by every project in the repository. -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Lemon Book Shell</Product>
    <Authors>Tracy Ma</Authors>
    <Copyright>Copyright (c) 2026 Tracy Ma</Copyright>
    <!--
      One version for the six packages (the shell's three and the hub client's three): bump it for every change the
      apps should get (NuGet caches by version).
    -->
    <Version>0.3.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The README packed as the package's own; the hub client's projects point at theirs. -->
    <PackageReadmePath Condition="'$(PackageReadmePath)' == ''">$(MSBuildThisFileDirectory)README.md</PackageReadmePath>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit findings stay warnings: a new advisory must not turn a green build red with no source change. -->
    <WarningsNotAsErrors>NU1507;NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(PackageReadmePath)" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>

</Project>
