<Project>

  <!-- Auto-imported by every project in the repository. -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Lemon Book Shell</Product>
    <Authors>Tracy Ma</Authors>
    <Copyright>Copyright (c) 2026 Tracy Ma</Copyright>
    <!-- One version for the three packages: bump it for every change the books should get (NuGet caches by version). -->
    <Version>0.1.6</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit findings stay warnings: a new advisory must not turn a green build red with no source change. -->
    <WarningsNotAsErrors>NU1507;NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
